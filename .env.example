# Ananke 环境变量模板
# 复制为 .env 后再填写自己的配置：cp .env.example .env
# .env 已被 .gitignore 忽略；不要提交或分享其中的 API Key。
# 本模板不替使用者预设模型家族；正式评估时，驱动端与评判端必须属于不同家族。

# =============================================================================
# 运行与实验
# =============================================================================

# true 使用离线 Mock LLM；false 使用下方配置的真实 API。
USE_MOCK_LLM=true

# persistence：存续检验；frequency：频率驱动对照组。
WORKING_PROMOTION_STRATEGY=persistence

# 新记忆与既有记忆的余弦相似度达到此值后，才进入关系分类。
R_RECALL=0.65

# 嵌入模型名称或本地路径。
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# 驱动端 LLM（提取 + 关系分类）
# =============================================================================

# 通用 OpenAI-compatible 接口使用 openai-compatible。
# Gemini 也可填 gemini；此时 LLM_BASE_URL 留空会使用其官方兼容端点。
LLM_PROVIDER=openai-compatible
LLM_API_KEY=

# 填 API 根地址，不要追加 /chat/completions。
# 示例：
#   Mistral   https://api.mistral.ai/v1
#   DeepSeek  https://api.deepseek.com/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Groq      https://api.groq.com/openai/v1
#   Ollama    http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=

# 通常可由模型名推断；仅在私有网关或不透明模型名下显式填写。
LLM_FAMILY=

# 判定型任务建议使用接近 0 的温度，以提高可复现性。
LLM_TEMPERATURE=0.0

# 按所用账户的请求速率限制填写；0 表示不做主动 RPM 限速。
LLM_RPM=30

# =============================================================================
# 评判端 LLM（正式评估使用，协议 v4 §5）
# =============================================================================

# 正式评估必须使用与驱动端不同家族的模型。
EVAL_LLM_PROVIDER=openai-compatible
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=

# 不预设；若无法从模型名推断，请手动填写，并确保与 LLM_FAMILY 不同。
EVAL_LLM_FAMILY=

# 0 表示不做主动 RPM 限速；服务端 429 仍会触发重试。
EVAL_LLM_RPM=0
