# ============================================================
# Ananke LLM 配置模板
# 复制本文件为 .env 并填入你自己的值：  cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进入 git。
# 所有字段均可选，留空即使用下方默认值。
# 冒烟配置参考（PI 已确认）：驱动端 Gemini(30 rpm) + 评判端 DeepSeek(不同家族, 协议 §5 分流)
# ============================================================

# ---- 运行模式 ----
# true  = 使用 Mock LLM（离线、无需密钥，秒级跑通迁移/激活逻辑，适合调试）
# false = 使用下方配置的真实 LLM
USE_MOCK_LLM=true

# ---- 实验组/对照组（可选）----
# persistence（默认，存续检验）= 外部验证权重高于内部激活
# frequency（对照组，频率驱动）= 仅按内部激活次数迁移
WORKING_PROMOTION_STRATEGY=persistence

# ---- v4 召回-分类两段式（协议 v4 §2，待冒烟校准）----
# 余弦召回阈值：新记忆 m 与既有记忆 e 的余弦 ≥ R_RECALL 才进入关系分类
R_RECALL=0.65
# 关系分类器方案：llm（方案乙，默认）| nli（方案甲，待接入）
RELATION_CLASSIFIER_SCHEME=llm

# ---- 嵌入模型（可选）----
# 默认 all-MiniLM-L6-v2 为英文模型；中文场景建议换成 bge-small-zh / m3e / bge-m3
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- 驱动端 LLM（提取+关系分类）----
# 支持：openai / deepseek / openrouter / groq / ollama / openai-compatible / gemini
# 这些都走 OpenAI 兼容接口，仅靠 base_url + api_key + model 区分，无需改代码。
# Gemini 走官方 OpenAI 兼容接口，base_url 留空会自动补默认端点。
LLM_PROVIDER=gemini
# 你的 API Key（必填，当 USE_MOCK_LLM=false 时）
LLM_API_KEY=
# 接口地址。Gemini 留空即自动使用官方 OpenAI 兼容端点；其它服务商示例：
#   DeepSeek  : https://api.deepseek.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq      : https://api.groq.com/openai/v1
#   Ollama    : http://localhost:11434/v1
LLM_BASE_URL=
# 模型名，随服务商而定（Gemini 示例：gemini-1.5-flash / gemini-2.0-flash）
LLM_MODEL=gemini-3.1-flash-lite
# 采样温度（记忆提取/重组判断建议接近 0 以稳定输出）
LLM_TEMPERATURE=0.0
# RPM 节流（I/O 韧性，不影响理论行为）：控制驱动端每分钟请求数，防撞 Gemini 限流。
# 免费层通常 15，部分 30；按你的 key 限额设定。
LLM_RPM=10

# ---- 评判端 LLM（v4 §5 评估独立性：不同家族主裁判）----
# 驱动端 = Gemini 提取；评判端 = DeepSeek/GLM 等**不同家族** LLM，
# 结构化判定「记忆 X 是否包含回答问题 Q 所需事实：包含/部分/不包含」。
# 默认 deepseek，与驱动端不同家族；嵌入模型在评估端禁止出现（防驱动-评判度量循环）。
# 注意：EVAL_LLM_BASE_URL 留空且 provider=deepseek 会落到 OpenAI 默认地址导致调用失败，
#       故此处直接填 DeepSeek 端点（协议 §5 分流的硬依赖）。
EVAL_LLM_PROVIDER=deepseek
# 评判端 API Key（必填，当 USE_MOCK_LLM=false 且需要真实评判时）
EVAL_LLM_API_KEY=
# 评判端接口地址（DeepSeek 示例：https://api.deepseek.com/v1）
EVAL_LLM_BASE_URL=https://api.deepseek.com/v1
# 评判端模型名
EVAL_LLM_MODEL=deepseek-v4-flash
# "部分包含"计分：命中=1.0（包含），partial=该系数（待冒烟校准），不含=0.0
EVAL_PARTIAL_CREDIT=0.5
